# Display name used by FastAPI's docs.
APP_NAME=FastAPI Async Task Platform

# Replace this with a long random value in your local .env file.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# These hostnames are Docker Compose service names, not localhost.
DATABASE_URL=postgresql+psycopg://app:app_password@db:5432/async_tasks
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
